NODE_ENV=development
PORT=5000
APP_NAME=Evvo ERP
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=evvo_erp
DB_USER=root
DB_PASSWORD=your_password
DB_DIALECT=mysql
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000
DB_LOGGING=false

# JWT
JWT_SECRET=change_this_to_a_very_long_random_string_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production_too
JWT_REFRESH_EXPIRES_IN=7d

# Encryption
ENCRYPTION_KEY=32_char_key_change_in_production

# SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@evvoerp.com
EMAIL_FROM_NAME=Evvo ERP

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Multi-tenant
ENABLE_MULTI_TENANT=true
